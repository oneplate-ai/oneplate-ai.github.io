---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ '/en/' | absolute_url }}</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  {% for series in site.data.series %}
    {% assign ko_posts = site.posts | where: 'series', series.slug | where: 'lang', 'ko' %}
    {% assign en_posts = site.posts | where: 'series', series.slug | where: 'lang', 'en' %}
    {% if ko_posts.size > 0 %}
  <url>
    <loc>{{ '/series/' | append: series.slug | append: '/' | absolute_url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
    {% endif %}
    {% if en_posts.size > 0 %}
  <url>
    <loc>{{ '/en/series/' | append: series.slug | append: '/' | absolute_url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
    {% endif %}
  {% endfor %}
  {% for post in site.posts %}
    {% if post.published != false %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
    {% endif %}
  {% endfor %}
</urlset>
